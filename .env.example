# ========================================================
# SKETCHFORCE: AI Forensic Composite Suite Configuration
# ========================================================

# Application Metadata
APP_NAME="EyeWitness: AI Forensic Composite Suite"
APP_VERSION="2.4.0-CLASSIFIED"
ENVIRONMENT="production"

# Security & Authentication (JWT)
SECRET_KEY="sketchforce_classified_jwt_secret_key_2026_law_enforcement"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Default: SQLite local fallback)
DATABASE_URL="sqlite:///./sketchforce.db"
# PostgreSQL Example:
# DATABASE_URL="postgresql://user:password@localhost:5432/sketchforce"

# AI Integration Layer Model Providers
# Options: 'mock' (default, offline standalone vectors), 'openai', 'gemini', 'stability'
AI_IMAGE_PROVIDER="mock"
AI_TEXT_PROVIDER="mock"
AI_VIDEO_PROVIDER="mock"

# External API Keys (Optional - Suite runs with full fidelity without any keys)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
STABILITY_API_KEY=""

# Frontend API URL
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# Emergency SOS System
SOS_ENABLED=true
SOS_SANDBOX=true
NEXT_PUBLIC_SOS_ENABLED=true
OFFICER_EMERGENCY_PHONE="+1-555-019-2044"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

